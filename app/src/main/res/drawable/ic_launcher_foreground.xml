<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT mark (design v3): bold check inside an orbit ring with one amber satellite in the ring gap.
     Everything stays inside the 66dp adaptive-icon safe zone (centre of the 108dp canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- orbit ring with a gap for the satellite -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M77.78,46.27A25,25 0,1 1 65.74,31.93" />
    <!-- check -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M42,55L51,64L67,46" />
    <!-- satellite -->
    <path
        android:fillColor="#FFB23F"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:pathData="M73.15,37.93m-5.5,0a5.5,5.5 0,1 1,11 0a5.5,5.5 0,1 1,-11 0" />
</vector>
